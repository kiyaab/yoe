# ===================================================
# 🎡 YALFAL ONLINE ETA — MASTER ENVIRONMENT CONFIG
# ===================================================

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Prisma)
# Example for local PostgreSQL 18 or Docker container
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yalfal_online_eta?schema=public

# JWT Secrets for Admin & Authenticated Sessions
JWT_SECRET=yalfal_super_secret_jwt_key_ethiopia_2026_change_in_production
JWT_EXPIRATION=7d

# Telegram Bot Credentials
# Obtain from @BotFather
TELEGRAM_BOT_TOKEN=7123456789:AAFakeTokenForProductionDemoEtaLotteryBot
# Comma-separated list of authorized Telegram User IDs for /admin panel
TELEGRAM_ADMIN_IDS=123456789,987654321
# Set to 'polling' for local development or 'webhook' for production deployment
TELEGRAM_BOT_MODE=polling
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=yalfal_webhook_secret_protection_key

# Redis (Optional: Used for Queues / Distributed Cache in Docker)
REDIS_URL=redis://localhost:6379

# Storage Configuration for Payment Receipts
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads/receipts
STORAGE_MAX_FILE_SIZE_MB=5

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Frontend Environment Variables (Prefix with NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=yalfalonlinebot
NEXT_PUBLIC_SUPPORT_PHONE=+251911000000
NEXT_PUBLIC_SUPPORT_TELEGRAM=@YalfalSupport
