NODE_ENV=production
PORT=4000

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yalfal_online_eta?schema=public

# JWT Secret for Authenticated API sessions
JWT_SECRET=yalfal_super_secret_jwt_key_ethiopia_2026_change_in_production
JWT_EXPIRATION=7d

# Telegram Bot Credentials (from @BotFather)
TELEGRAM_BOT_TOKEN=8880998246:AAFkEAPFE2Jj1ZSpn3NzqxIqrgqvJXmVacM

# Comma-separated list of authorized Telegram User IDs for /admin panel
TELEGRAM_ADMIN_IDS=123456789,987654321

# Bot Operating Mode: 'polling' for local dev / simple deployment, or 'webhook' for high-concurrency production
TELEGRAM_BOT_MODE=polling
TELEGRAM_WEBHOOK_URL=https://your-service.onrender.com/api/telegram/webhook
