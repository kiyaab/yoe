# Storage Configuration for Payment Receipts
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads/receipts
STORAGE_MAX_FILE_SIZE_MB=5

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120
