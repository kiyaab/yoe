# ===================================================
# 🎡 YALFAL ONLINE ETA — MASTER ENVIRONMENT CONFIG
# Telegram-Only Digital Lottery Bot
# ===================================================

NODE_ENV=production
PORT=4000

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yalfal_online_eta?schema=public

# JWT Secret for Authenticated API sessions
JWT_SECRET=yalfal_super_secret_jwt_key_ethiopia_2026_change_in_production
JWT_EXPIRATION=7d

# Telegram Bot Credentials (from @BotFather)
# ⚠️ SECURITY NOTICE: NEVER COMMIT YOUR REAL BOT TOKEN. Revoke exposed tokens in @BotFather.
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz_your_token_here

# Comma-separated list of authorized Telegram User IDs for /admin panel
TELEGRAM_ADMIN_IDS=123456789,987654321

# Bot Operating Mode: 'webhook' for 24/7 VPS production, or 'polling' for local dev
TELEGRAM_BOT_MODE=webhook
TELEGRAM_WEBHOOK_DOMAIN=bot.yourdomain.com
TELEGRAM_WEBHOOK_SECRET=yalfal_webhook_secret_protection_key_32_chars

# Redis (Optional: Used for Queues / Distributed Locking)
REDIS_URL=redis://localhost:6379

# Storage Configuration for Payment Receipts
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads/receipts
STORAGE_MAX_FILE_SIZE_MB=5

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120
