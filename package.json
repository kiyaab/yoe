{
  "name": "yalfal-online-eta",
  "version": "2.0.0",
  "description": "Unified Next.js Fullstack WebApp & Telegram Mini App for Yalfal Online Eta",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
